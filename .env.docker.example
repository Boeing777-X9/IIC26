# Retinix Docker Environment Configuration Example
# Copy this file to .env and adjust variables as needed:
# cp .env.docker.example .env

# Backend MongoDB Configuration (MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=retinagrid

# Frontend API Configuration
# Use your domain or server IP in production (e.g., https://api.yourdomain.com/api or http://YOUR_SERVER_IP:8000/api)
NEXT_PUBLIC_API_BASE=http://localhost:8000/api
